[package]
name = "libgweather"
version = "4.8.0"
authors = ["Jamie Murphy <hello@itsjamie.dev>"]
edition = "2024"
readme = "../README.md"
homepage = "https://gitlab.gnome.org/World/Rust/libgweather-rs"
description = "Rust bindings for libgweather"
license = "MIT"
repository = "https://gitlab.gnome.org/World/Rust/libgweather-rs"
documentation = "https://world.pages.gitlab.gnome.org/Rust/libgweather-rs"
categories = ["api-bindings"]
keywords = ["gtk-rs", "gnome", "weather", "gweather"]

[lib]
name = "libgweather"

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--generate-link-to-definition"]

[dependencies]
libc = "0.2"

[dependencies.ffi]
package = "gweather-sys"
path = "./sys"
version = "4.8.0"

[dependencies.glib]
git = "https://github.com/gtk-rs/gtk-rs-core"
branch = "0.22"
version = "0.22"

[dependencies.gio]
git = "https://github.com/gtk-rs/gtk-rs-core"
branch = "0.22"
version = "0.22"

[features]
